# ── OS generated files ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ────────────────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Java / Maven ───────────────────────────────────────────────────────────
target/
*.class
*.jar
*.war
!**/src/main/**/target/

# ── Node / Angular ─────────────────────────────────────────────────────────
node_modules/
dist/
.angular/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/

# ── Docker ────────────────────────────────────────────────────────────────
.env           # never commit secrets!

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
logs/
