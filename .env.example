# ERP Platform – Environment Variables
# Copy this file to .env and fill in the values before running docker-compose.

# PostgreSQL
POSTGRES_USER=erp
POSTGRES_PASSWORD=change_me_in_production

# JWT secret (min 256-bit / 32 chars, base64-encoded recommended)
# Generate: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_BASE64_STRING_HERE_AT_LEAST_256_BITS
